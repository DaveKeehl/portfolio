---
import Section from "@components/Section.astro";
---

<div data-section="contact">
  <Section
    id="contact"
    heading="Let's talk!"
    headingGap="small"
    icon="ChatTeardropDots"
  >
    <div class="rich-text rich-text-contact text-left text-blue-100">
      <p>
        Got something on your mind? Drop me an email at <a
          href="mailto:davide.woelckner@gmail.com">davide.woelckner@gmail.com</a
        >
      </p>
    </div>
  </Section>
</div>

<style>
  .rich-text-contact :global(a) {
    font-family: var(--font-code);
    font-size: var(--text-p4);
    font-weight: 700;
  }
</style>
