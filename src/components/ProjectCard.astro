---
import { cva } from "class-variance-authority";
import { cn } from "@utils/cn";
import Button from "./Button.astro";
import ButtonsGroup from "./ButtonsGroup.astro";
import Label from "./Label.astro";

interface Project {
  title: string;
  image: { url: string; alt?: string };
  liveButton?: { text: string; url: string } | null;
  repositoryButton?: { text: string; url: string } | null;
  excerpt: string;
  type: string;
}

interface Props {
  project: Project;
  reversed?: boolean;
}

const { project, reversed = false } = Astro.props;
const { title, image, liveButton, repositoryButton, excerpt, type } = project;

const imageContainerStyles = cva(
  [
    "flex",
    "col-[5/-1]",
    "row-[1/2]",
    "relative",
    "rounded-[20px]",
    "overflow-hidden",
    "border",
    "border-solid",
    "border-turquoise-200/5",
    "mb-5",
    "lg:mb-0",
    "before:content-['']",
    "before:hidden",
    "before:absolute",
    "before:bg-project-card",
    "before:top-0",
    "before:left-0",
    "before:w-full",
    "before:h-full",
    "before:z-[5]",
    "before:pointer-events-none",
    "before:lg:block",
  ],
  {
    variants: {
      reversed: {
        true: ["col-[1/7]", "before:bg-project-card-reversed"],
      },
    },
  },
);

const contentStyles = cva(["z-[5]", "col-[1/6]", "row-[1/2]"], {
  variants: {
    reversed: {
      true: ["col-[6/-1]"],
    },
  },
});
---

<div
  class="flex flex-col lg:grid lg:grid-cols-10 lg:grid-rows-1 lg:items-center"
>
  <div class={cn(imageContainerStyles({ reversed }))}>
    <img
      src={image.url}
      alt={title}
      class="aspect-16/10 h-full w-full object-cover"
      loading="lazy"
    />
  </div>

  <div class={cn(contentStyles({ reversed }))}>
    <Label>{type}</Label>
    <p class="h3-bold mt-5 mb-4">{title}</p>
    <p class="p5-regular mb-9 text-blue-100 opacity-90">{excerpt}</p>

    {
      liveButton && repositoryButton ? (
        <ButtonsGroup
          size="small"
          primary={{ text: liveButton.text, href: liveButton.url, external: true }}
          secondary={{ text: repositoryButton.text, href: repositoryButton.url, external: true }}
        />
      ) : liveButton ? (
        <Button size="small" variant="primary" href={liveButton.url} external>
          {liveButton.text}
        </Button>
      ) : repositoryButton ? (
        <Button size="small" variant="secondary" href={repositoryButton.url} external>
          {repositoryButton.text}
        </Button>
      ) : null
    }
  </div>
</div>
