---
import Section from "@components/Section.astro";
import BlogCard from "@components/BlogCard.astro";
import Button from "@components/Button.astro";
---

<div data-section="blog">
  <Section
    id="blog"
    heading="Blog"
    headingGap="small"
    icon="Quotes"
    class="scroll-pt-8"
  >
    <div
      class="lg:grid-cols-blog-posts grid grid-cols-1 gap-x-5 gap-y-14"
      data-blog-cards
    >
      <div data-card-index="0">
        <BlogCard
          _type="caseStudy"
          title="Svelte Reveal"
          slug="svelte-reveal"
          excerpt="An open-source NPM package to easily create reveal on scroll animations in Svelte with first-class TypeScript support and near zero configuration."
          image={{
            url: "/images/svelte-reveal.png",
            alt: "Svelte Reveal logo",
          }}
        />
      </div>
      <div data-card-index="1">
        <BlogCard
          _type="caseStudy"
          title="F1 Insight"
          slug="f1-insight"
          excerpt="A visual analytics web application to easily gain insight into the current Formula 1 season, and spot trends that would otherwise be difficult to notice."
          image={{
            url: "/images/f1-insight.png",
            alt: "F1 Insight logo",
          }}
        />
      </div>
      <div data-card-index="2">
        <BlogCard
          _type="caseStudy"
          title="Stack and Heap Diagram"
          slug="stack-and-heap-diagram"
          excerpt="An interactive web application to easily create and manipulate stack and heap diagrams in the context of a university programming fundamentals course."
          image={{
            url: "/images/stack-and-heap-diagram.png",
            alt: "Stack and Heap Diagram logo",
          }}
        />
      </div>
      <div data-card-index="3">
        <BlogCard
          _type="caseStudy"
          title="Fonts Jar"
          slug="fonts-jar"
          excerpt="An open-source Chrome extension to save your favorite fonts from a list of supported websites (including Google Fonts and Adobe Fonts), so you never forget they exist."
          image={{
            url: "/images/fonts-jar.png",
            alt: "Fonts Jar logo",
          }}
        />
      </div>
      <div data-card-index="4" class="hidden">
        <BlogCard
          _type="caseStudy"
          title="Portfolio Website (2022)"
          slug="personal-portfolio"
          excerpt="The latest version (2022) of my personal portfolio website, where you can find some information about myself, my latest and most representative projects."
          image={{
            url: "/og_image.png",
            alt: "Personal portfolio socials card",
          }}
        />
      </div>
    </div>

    <div class="mt-20 grid place-items-center" data-load-more-container>
      <Button data-action="load-more">Load more posts</Button>
    </div>
  </Section>
</div>

<script>
  const pillContainer = document.querySelector("[data-pill-container]");
  const selectedLabels = new Set<string>();

  if (pillContainer) {
    pillContainer
      .querySelectorAll<HTMLElement>("[data-label]")
      .forEach((pill) => {
        pill.addEventListener("click", () => {
          const label = pill.dataset.label!;

          if (selectedLabels.has(label)) {
            selectedLabels.delete(label);
            pill.classList.remove("shadow-secondary-btn-focus");
          } else {
            selectedLabels.add(label);
            pill.classList.add("shadow-secondary-btn-focus");
          }

          const cards =
            document.querySelectorAll<HTMLElement>("[data-card-index]");
          const blogCards = document.querySelector("[data-blog-cards]");
          if (!blogCards) return;

          cards.forEach((card) => {
            const typeEl = card.querySelector("[data-type]");
            if (!typeEl) return;
            const type = (typeEl as HTMLElement).dataset.type;

            if (
              selectedLabels.size === 0 ||
              (type && selectedLabels.has(type))
            ) {
              card.classList.remove("filter-hidden");
            } else {
              card.classList.add("filter-hidden");
            }
          });

          updateLoadMore();
        });
      });
  }

  function updateLoadMore() {
    const loadMoreContainer = document.querySelector(
      "[data-load-more-container]",
    );
    const visibleCards = document.querySelectorAll(
      "[data-card-index]:not(.filter-hidden)",
    );
    if (loadMoreContainer) {
      if (visibleCards.length <= 4) {
        loadMoreContainer.classList.add("hidden");
      } else {
        loadMoreContainer.classList.remove("hidden");
      }
    }
  }

  const container = document.querySelector("[data-blog-cards]");
  const loadMoreBtn = document.querySelector('[data-action="load-more"]');
  const loadMoreContainer = document.querySelector(
    "[data-load-more-container]",
  );

  if (container && loadMoreBtn) {
    let cursor = 4;

    loadMoreBtn.addEventListener("click", () => {
      cursor += 4;
      const cards = container.querySelectorAll("[data-card-index]");
      cards.forEach((card) => {
        const index = parseInt(card.getAttribute("data-card-index") || "0");
        if (index < cursor) {
          card.classList.remove("hidden");
        }
      });
      if (cursor >= 5 && loadMoreContainer) {
        loadMoreContainer.classList.add("hidden");
      }
    });
  }
</script>

<style>
  :global(.filter-hidden) {
    display: none !important;
  }
</style>
