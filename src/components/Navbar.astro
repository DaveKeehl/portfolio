---
import NavbarItem from "./NavbarItem.astro";
import { cn } from "@utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<nav class={cn("no-scrollbar flex gap-6", className)} data-navbar>
  <NavbarItem name="Welcome" />
  <NavbarItem name="About" />
  <NavbarItem name="Projects" />
  <NavbarItem name="Contact" />
</nav>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>("[data-nav-section]")
    .forEach((link) => {
      link.addEventListener("click", (e) => {
        if (window.location.pathname === "/") {
          e.preventDefault();
          const sectionName = link.dataset.navSection;
          if (sectionName) {
            document
              .querySelector(`#${sectionName}`)
              ?.scrollIntoView({ behavior: "smooth" });
            window.history.pushState(
              { section: sectionName },
              "",
              `#${sectionName}`,
            );
          }
        }
      });
    });

  // Highlight active section
  const observer = new MutationObserver(() => {
    const activeSection = document.documentElement.dataset.activeSection;
    document
      .querySelectorAll<HTMLAnchorElement>("[data-nav-section]")
      .forEach((link) => {
        if (link.dataset.navSection === activeSection) {
          link.classList.add("text-grayscale-100");
          link.classList.remove("text-blue-200");
        } else {
          link.classList.remove("text-grayscale-100");
          link.classList.add("text-blue-200");
        }
      });
  });

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-active-section"],
  });
</script>
