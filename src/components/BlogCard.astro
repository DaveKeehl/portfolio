---
import Label from './Label.astro';
import { deCamelCase } from '@utils/functions';

interface Props {
  title: string;
  slug: string;
  image: { url: string; alt?: string };
  _type: string;
  excerpt: string;
}

const { title, slug, image, _type, excerpt } = Astro.props;

const cleanType = deCamelCase(_type);
const resource = _type === 'caseStudy' ? 'project' : 'article';
const href = `/${resource}/${slug}`;
---

<div class="flex flex-col" data-type={cleanType}>
  <a {href} class="mb-6 flex overflow-hidden rounded-2xl border border-turquoise-200/5">
    <img
      src={image.url}
      alt={image.alt || title}
      class="aspect-video w-full object-cover transition-transform hover:scale-[1.02]"
      loading="lazy"
    />
  </a>
  <Label>{cleanType}</Label>
  <a {href} class="h3-bold mt-4 mb-2 block w-fit">{title}</a>
  <p class="p5-regular text-blue-100 opacity-80">{excerpt}</p>
</div>
