---
import { Image } from "astro:assets";
import Section from "@components/Section.astro";
import Button from "@components/Button.astro";
---

<div data-section="about">
  <Section
    heading="Let me introduce myself"
    icon="HandWaving"
    headingGap="small"
    id="about"
    class="bg-about pt-24"
  >
    <div class="relative flex flex-col gap-10">
      <div
        class="p4-regular rich-text rich-text-about w-full text-blue-100 opacity-90 lg:w-8/12"
      >
        <p>
          I'm a frontend engineer who treats the web as a craft. I care deeply
          about the details — the kind that make an interface feel intentional,
          whether that's a well-thought-out architecture, a clean component API,
          or a layout that makes complex data easy to digest. I do my best work
          where engineering rigour meets design sensibility.
        </p>
        <p>
          I currently work at Duferco (Lugano), within the innovation division,
          where I build internal tools for companies across the group. I own the
          full frontend side of the projects I work on — from early design
          decisions to final implementation. I'm at my best when the data is
          complex, the experience needs to feel simple, and the end result has a
          real impact on the people who rely on it.
        </p>
        <p>
          When I'm not writing code, I'm probably chilling with my wife,
          watching Zelda theories or compulsively researching new guitar gear.
        </p>
      </div>
      <Button href="/davide_woelckner_cv.pdf" external>Look at my resume</Button
      >
      <div
        class="group outline-turquoise-200/6 absolute top-0 right-0 hidden h-105 w-73.75 -rotate-[5.4deg] rounded-2xl mix-blend-lighten outline transition-transform duration-300 hover:-rotate-[4deg] lg:block"
      >
        <div
          class="bg-about-img absolute top-0 left-0 z-10 h-full w-full transition-opacity duration-300 group-hover:opacity-80"
        >
        </div>
        <Image
          src="/images/about.png"
          alt="Davide Wölckner"
          width={295}
          height={420}
          class="absolute top-0 left-0 h-full w-full rounded-2xl bg-cover object-cover opacity-60 transition-opacity duration-300 group-hover:opacity-80"
        />
      </div>
    </div>
  </Section>
</div>

<style>
  .rich-text-about :global(a) {
    text-decoration: underline;
  }
  .rich-text-about :global(a:hover) {
    color: var(--color-grayscale-100);
  }
</style>
