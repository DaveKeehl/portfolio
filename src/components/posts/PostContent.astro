---
interface Props {
  maxWidth: number;
  image: { url: string; alt?: string };
}

const { maxWidth, image } = Astro.props;
---

<div class="post bg-post relative flex w-full justify-center">
  <div class="w-10/12" style={`max-width: ${maxWidth}px`}>
    <div
      class="border-turquoise-200/5 absolute top-0 left-1/2 flex w-10/12 max-w-[700px] -translate-x-1/2 -translate-y-1/2 overflow-hidden rounded-[20px] border lg:max-w-[700px]"
    >
      <img
        src={image.url}
        alt={image.alt || ""}
        class="aspect-video object-cover transition-transform hover:scale-[1.02]"
      />
    </div>
    <div
      class="xs:mt-[200px] mt-[150px] mb-16 sm:mt-60 md:mt-64 md:mb-[104px] lg:mt-64"
    >
      <slot />
    </div>
  </div>
</div>
