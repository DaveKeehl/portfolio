---
import ProjectCard from "@components/ProjectCard.astro";
import Section from "@components/Section.astro";
---

<div data-section="projects">
  <Section
    id="projects"
    heading="Featured projects."
    headingGap="large"
    icon="Fire"
    class="scroll-pt-8"
  >
    <div class="grid gap-14">
      <ProjectCard
        project={{
          title: "Portfolio Website (2022)",
          slug: "personal-portfolio",
          excerpt:
            "The latest version (2022) of my personal portfolio website, where you can find some information about myself, my latest and most representative projects and some blog articles.",
          image: {
            url: "/og_image.png",
            alt: "Personal portfolio socials card",
          },
          type: "Website",
          liveButton: null,
        }}
      />
      <ProjectCard
        reversed
        project={{
          title: "Stack and Heap Diagram",
          slug: "stack-and-heap-diagram",
          excerpt:
            "An interactive web application to easily create and manipulate stack and heap diagrams in the context of a university programming fundamentals course.",
          image: {
            url: "/images/stack-and-heap-diagram-98d19b344d06d1a39c38a90ea9d7bf2ed3097907-1920x930.png",
            alt: "Stack and Heap Diagram logo",
          },
          type: "Web Application",
          liveButton: {
            text: "Visit application",
            url: "https://stackandheap.netlify.app/",
          },
        }}
      />
      <ProjectCard
        project={{
          title: "Fonts Jar",
          slug: "fonts-jar",
          excerpt:
            "An open-source Chrome extension to save your favorite fonts from a list of supported websites (including Google Fonts and Adobe Fonts), so you never forget they exist.",
          image: {
            url: "/images/fonts-jar-89e03436efd62c453c1ca6ec730405743b190ddd-1920x960.png",
            alt: "Fonts Jar logo",
          },
          type: "Chrome Extension",
          liveButton: {
            text: "Visit store listing",
            url: "https://chrome.google.com/webstore/detail/fonts-jar/hkkhacceelmpcaiegjpijfpgaefokagj",
          },
        }}
      />
      <ProjectCard
        reversed
        project={{
          title: "Svelte Reveal",
          slug: "svelte-reveal",
          excerpt:
            "An open-source NPM package to easily create reveal on scroll animations in Svelte with first-class TypeScript support and near zero configuration.",
          image: {
            url: "/images/svelte-reveal-a94a03dd4c9667986c34f066556ff61cca3d87ac-1665x833.png",
            alt: "Svelte Reveal logo",
          },
          type: "NPM Package",
          liveButton: {
            text: "Open playground",
            url: "https://svelte.dev/repl/1cf37b0947ac46b8ae9cc791abda7159?version=3.44.1",
          },
        }}
      />
      <ProjectCard
        project={{
          title: "F1 Insight",
          slug: "f1-insight",
          excerpt:
            "A visual analytics web application to easily gain insight into the current Formula 1 season, and spot trends that would otherwise be difficult to notice.",
          image: {
            url: "/images/f1-insight-90e8ba60ea966599f5ef55cd051eae8b23fb2a1a-1441x720.png",
            alt: "F1 Insight logo",
          },
          type: "Web Application",
          liveButton: {
            text: "Visit application",
            url: "https://f1-insight.com",
          },
        }}
      />
    </div>
  </Section>
</div>
