---
import { cn } from "@utils/cn";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class={cn(
    "absolute bottom-0 left-1/2 -z-1 aspect-square w-150 -translate-x-1/2 translate-y-1/2 rounded-full bg-blue-100 opacity-25 blur-circle",
    className,
  )}
>
</div>

<style>
  div {
    backface-visibility: hidden;
  }

  @supports (-moz-appearance: none) {
    div {
      opacity: 0.1;
      scale: 1.5;
    }
  }
</style>
