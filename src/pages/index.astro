---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Hero from "@components/sections/Hero.astro";
import About from "@components/sections/About.astro";
import Projects from "@components/sections/Projects.astro";
import Contact from "@components/sections/Contact.astro";
import Footer from "@components/sections/Footer.astro";
import Container from "@components/Container.astro";
---

<BaseLayout
  title="Davide Wölckner"
  description="Davide Wölckner - Software engineer with a passion for the web, frontend engineering and UI/UX design."
  openGraph={{ image: "/og_image.png" }}
>
  <Header />
  <Hero />
  <div class="flex flex-col gap-32 lg:gap-40">
    <About />
    <Projects />
    <Contact />
    <Container class="md:pl-20">
      <Footer />
    </Container>
  </div>
</BaseLayout>

<script>
  // Global scroll spy: activate the last section whose top has crossed the
  // threshold line, falling back to the last section when near the bottom.
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>("[data-section]"),
  );
  const OFFSET = 100; // px from viewport top (accounts for sticky header)

  function updateActiveSection() {
    const nearBottom =
      window.scrollY + window.innerHeight >=
      document.documentElement.scrollHeight - 10;

    if (nearBottom) {
      const last = sections.at(-1);
      if (last?.dataset.section)
        document.documentElement.dataset.activeSection = last.dataset.section;
      return;
    }

    let best = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= OFFSET) best = section;
    }

    if (best?.dataset.section)
      document.documentElement.dataset.activeSection = best.dataset.section;
  }

  window.addEventListener("scroll", updateActiveSection, { passive: true });
  updateActiveSection();
</script>
