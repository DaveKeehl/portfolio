---
import Navbar from "./Navbar.astro";
import Container from "./Container.astro";
import Socials from "./Socials.astro";
---

<header
  id="site-header"
  class="before:bg-header pointer-events-auto sticky top-0 left-0 z-10 w-full translate-y-0 opacity-100 backdrop-blur-[10px] transition-all duration-300 before:absolute before:bottom-0 before:h-px before:w-full before:content-[''] after:pointer-events-none after:absolute after:top-0 after:left-0 after:-z-1 after:h-full after:w-full after:bg-blue-400 after:opacity-75 after:content-['']"
>
  <Container>
    <div
      class="text-grayscale-100 flex w-full items-center justify-between py-4.5"
    >
      <div class="flex flex-none justify-start lg:flex-1">
        <a href="/" class="flex h-8">
          <img src="/images/logo.svg" alt="Logo" />
        </a>
      </div>
      <div class="hidden lg:flex">
        <Navbar />
      </div>
      <div class="flex flex-none justify-end lg:flex-1">
        <Socials />
      </div>
    </div>
  </Container>
  <div
    class="before:bg-header relative flex w-full justify-center overflow-hidden before:absolute before:top-0 before:h-px before:w-full before:content-[''] lg:hidden"
  >
    <Navbar class="w-10/12 overflow-scroll py-3.5 sm:justify-center" />
  </div>
</header>

<style>
  .headerHidden {
    opacity: 0;
    transform: translateY(-20px);
    pointer-events: none;
  }
</style>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    let lastY = 0;
    let isVisible = true;

    function checkVisibility(y: number): boolean {
      const TOLERANCE = 0;
      const dy = lastY - y;
      lastY = y;
      if (lastY <= 0) return true;
      if (Math.abs(dy) <= TOLERANCE) return isVisible;
      return dy > TOLERANCE;
    }

    window.addEventListener("scroll", () => {
      const newVisible = checkVisibility(window.scrollY);
      if (newVisible !== isVisible) {
        isVisible = newVisible;
        if (isVisible) {
          header.classList.remove("headerHidden");
        } else {
          header.classList.add("headerHidden");
        }
      }
    });
  }
</script>
